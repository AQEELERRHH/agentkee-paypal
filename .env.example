# PayPal sandbox app (developer.paypal.com > Apps & Credentials > Sandbox)
# The app must be linked to a sandbox Business account in a country that can
# receive payments (e.g. United States).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API=https://api-m.sandbox.paypal.com

# AI provider for the semantic check: openai | groq | gemini | anthropic
AI_PROVIDER=
AI_API_KEY=
# Optional model override (defaults: gpt-4o-mini, llama-3.3-70b-versatile, gemini-3.8-flash, claude-sonnet-4-5)
AI_MODEL=

# Public URL PayPal redirects back to. Leave empty locally (http://localhost:3000).
# On Render this is detected automatically from RENDER_EXTERNAL_URL.
BASE_URL=
PORT=3000
